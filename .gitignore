# Python
__pycache__/
*.pyc

# Cached price history - re-downloaded on demand, large, and changes every day
fractal/cache/

# The trim log is a record of this machine's runs, like the position book.
fractal/data/portfolio_trims.csv

# Run artefacts. docs/index.html is the published copy and IS tracked.
fractal/out/logs/
fractal/out/*.csv
fractal/out/*.eml
fractal/out/.last_sent
fractal/out/.alerted
fractal/out/.locked

# Never commit credentials. The app password lives in the Windows user
# environment (FRACTAL_SMTP_PASS), never in the repo.
.env
*.secret

# Third-party research. These are inputs to calibration, not part of the model:
# Hedgeye's subscriber reports carry an explicit "may not be forwarded or otherwise
# provided to any unauthorized party" notice, and the Similar Set newsletters and
# charts are their product. They stay on disk so the fits can be re-run locally,
# but they are not redistributed.
*.pdf
# Everything under reference/ is subscriber research and stays out of the repo.
# This was three per-file patterns keyed to "hedgeye_*", and the first reference
# file that did not happen to start with that prefix -- macroshow_positions.csv --
# was staged for commit into a PUBLIC repo before anyone noticed. A directory rule
# cannot be slipped past by a filename.
fractal/reference/
# The dashboard is published as docs/index.html; the copy under out/ is a build
# artefact and would otherwise be committed twice with identical content.
fractal/out/*.html
fractal/out/.track_sent
